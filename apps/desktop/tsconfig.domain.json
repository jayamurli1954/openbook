{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src/domain",
    "outDir": "dist-domain",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src/domain/**/*.ts"],
  "exclude": [
    "src/domain/desktopStudioCoordinator.ts",
    "src/domain/desktopStudioCoordinator.test.ts",
    "src/domain/desktopStudioCoordinator.import.test.ts"
  ]
}
