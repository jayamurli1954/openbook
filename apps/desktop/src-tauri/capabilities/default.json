{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the OpenBook foundation desktop shell plus Gate 9 export dialogs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "dialog:default",
    "allow-export-path-exists",
    "allow-export-write-atomically",
    "allow-asset-read-bytes"
  ]
}
