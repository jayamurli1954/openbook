{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayamurli1954/openbook/blob/main/docs/release-compliance/release-artifact-manifest.schema.json",
  "title": "OpenBook Release Artifact Manifest",
  "description": "Schema for release-oriented artifact and evidence metadata. This contract is not an application or publishing source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestKind", "release", "artifacts"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "manifestKind": { "type": "string", "const": "release-artifact-manifest" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit"],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "dependencyLock": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["confirmed", "unresolved", "not-applicable"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classification", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "classification": {
          "type": "string",
          "enum": ["application", "installer", "archive", "runtime", "asset", "documentation", "other"]
        },
        "status": { "$ref": "#/$defs/status" },
        "path": { "type": "string", "minLength": 1 },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "evidenceReferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "noticeReferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fontEvidenceReferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "validationEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
