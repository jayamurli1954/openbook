{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayamurli1954/openbook/blob/main/docs/release-compliance/evidence-inventory.schema.json",
  "title": "OpenBook Release Evidence Inventory",
  "description": "Schema for release-oriented provenance and compliance evidence. This contract records evidence metadata; it is not an application or publishing source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryKind",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "inventoryKind": {
      "type": "string",
      "const": "release-evidence-inventory"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceCommit": { "type": "string", "minLength": 1 },
        "dependencyLock": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceEntry" }
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "classification",
        "status"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "source",
            "development",
            "build",
            "test",
            "shipped-runtime",
            "shipped-asset"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unresolved",
            "not-applicable"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "sourceReference": { "type": "string", "minLength": 1 },
            "integrity": { "type": "string", "minLength": 1 }
          }
        },
        "licensing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "license": { "type": "string", "minLength": 1 },
            "basis": { "type": "string", "minLength": 1 },
            "noticeRequired": { "type": "boolean" },
            "redistribution": {
              "type": "string",
              "enum": [
                "permitted",
                "conditional",
                "not-permitted",
                "unresolved",
                "not-applicable"
              ]
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
