{
  "name": "openbook",
  "private": true,
  "description": "OpenBook Studio monorepo — Book Model first. Not an EPUB editor.",
  "workspaces": [
    "packages/book-model"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @openbook/book-model",
    "test": "npm test -w @openbook/book-model",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
